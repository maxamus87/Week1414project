# From your Supabase project: Project Settings -> Database -> Connect
DATABASE_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?schema=public"
# If your project has a separate transaction pooler URI, use it for DATABASE_URL above
# and keep this one (the direct/non-pooled connection) for Prisma migrations.
DIRECT_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?schema=public"
PORT=3001
JWT_SECRET=change-this-to-a-long-random-string
